#include <stdio.h>
int main()
{
    int num; 
    printf("Enter number :");
    scanf("%d", &num);
    int product = 1;
    while(num !=0)
    {
        int digit = num % 10;
        if(digit % 2 != 0)
        {
            product *= digit;
        }
        num /= 10;
    }
    printf("Product of odd digits : %d", product);
    return 0;
}
