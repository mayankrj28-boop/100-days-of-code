#include <stdio.h>
int main()
{
    int num;
    printf("Enter number : ");
    scanf("%d", &num);

    int ognum = num;
    int count = 0;
    int i = 0;
    int ar[49];
    ar[0] = 0;
    while(num != 0)
    {
        count++;
        ar[i] = num % 10;
        i++;
        num /= 10;
    }

    for (int j = count-1 ; j >= 0; j--)
    {
        if(ar[j]==0)
        {
            printf("1");
        }
        else if(ar[j]==1)
        {
            printf("0");
        }
        else 
        {
            printf("Invalid binary input");
            break;
        }
    }
}
