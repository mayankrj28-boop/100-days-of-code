#include <stdio.h>
#include <math.h>
int main()
{
    float r, p;
    int t;
    printf("Enter principal :");
    scanf("%f", &p);
    printf("Enter Interest :");
    scanf("%f", &r);
    printf("Enter time :");
    scanf("%d", &t);
    float si = (p * t * r) / 100.0;
    float ci = p * pow((1 + r / 100.0), t) - p;
    printf("S.I = %f\tC.I=%f", si, ci);
    return 0;
}
