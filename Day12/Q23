#include <stdio.h>
int main()
{
    printf("Enter number of days late : ");
    int late;
    scanf("%d", &late);
    int fine;
    if (late <= 5)
    {
        fine = 2 * late;
    }
    else if (late <= 10)
    {
        fine = (2 * 5) + (4 * (late - 5));
    }
    else if (late <= 30)
    {
        fine = (2 * 5) + (4 * 5) + (6 * (late - 10 ));
    }
    else 
    {
        printf("Membership cancelled ");
        return 0;
    }

    printf("Fine :%d Rupee", fine);

    return 0;
}
