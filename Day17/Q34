#include <stdio.h>
int main()
{
    int num, count = 0;
    printf("Enter Number :");
    scanf("%d", &num);

    for (int i = 2; i < num; i++)
    {
        if(num%i==0)
        {
            count++;
            break;
        }
    }

    count == 0 ? printf("Prime number ") : printf("Not prime ");
    return 0;
}
