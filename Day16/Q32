#include <stdio.h>

int main()
{
    int num, onum, palindrome=0;
    printf("Enter number : ");
    scanf("%d", &num);

    onum = num;
    while (num > 0)
    {
        palindrome = palindrome + num % 10;
        palindrome *= 10;
        num /= 10;
    }

    palindrome /= 10;

    if (palindrome == onum)
    {
        printf("Palindrome");
    }
    else
    {
        printf("Not palindrome ");
    }
}
