#include <stdio.h>
int main()
{
    int ar[50], num, i = 0, count = 0;
    printf("Enter number : ");
    scanf("%d", &num);

    while (num > 0)
    {
        ar[i] = num % 2;
        num /= 2;
        i++;
        count++;
    }

    for (int j = count - 1; j >= 0; j--)
    {
        printf("%d", ar[j]);
    }
    return 0;
}
