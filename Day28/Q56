#include <stdio.h>
int l;
int input()
{
    printf("Enter length of Array. ");
    scanf("%d", &l);
}

int main()
{
    input();
    int ar[l];
    for (int i = 0; i < l; i++)
    {
        printf("Enter element for %d index :", i);
        scanf("%d", &ar[i]);
    }
    printf("\n\n\n");
    for (int i = 0; i < l; i++)
    {
        printf("Enter element for %d index :%d\n", i, ar[i]);
    }
}
