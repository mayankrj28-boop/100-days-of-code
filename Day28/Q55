#include <stdio.h>
int prime(int a)
{
    for (int i = 2; i < a; i++)
    {
        if (a % i == 0)
        {
            return 0;
        }
    }
    return 1;
}

int main()
{
    static int n;
    printf("Enter number :");
    scanf("%d", &n);
    for (int i = 2; i <= n; i++)
        if (prime(i))
            printf("%d  ", i);
    return 0;
}
