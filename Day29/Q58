#include <stdio.h>
      int l;
int input()
{
    printf("Enter length of Array. ");
    scanf("%d", &l);
}

int main()
{
    input();
    int ar[l];
    for (int i = 0; i < l; i++)
    {
        printf("Enter element for %d index :", i);
        scanf("%d", &ar[i]);
    }
    int max = ar[0];
    int min = ar[0];
    for (int i = 0; i < l; i++)
    {
        if(ar[i]>max)
        {
            max = ar[i];
        }
        if(ar[i]<min)
        {
            min = ar[i];
        }
    }
    printf("Max : %d, Min :%d", max, min);
}
