#include <stdio.h>
int main ()
{
    int num, rnum=0;
    printf("Enter Number :");
    scanf("%d", &num);
    int onum = num;
    while(num>0)
    {
        rnum = rnum + num % 10;
        rnum *= 10;
        num /= 10;
    }

    rnum /= 10;

    printf("Original number : %d\nReverse Nubmer: %d", onum, rnum);
}
