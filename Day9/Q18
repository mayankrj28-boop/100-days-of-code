#include <stdio.h>
int main()
{
    printf("Enter your percentage :");
    float per;
    scanf("%f", &per);

    if (per >= 90 && per <= 100)
    {
        printf("Grade A");
    }
    else if (per >= 80 && per < 90)
    {
        printf("Grade B");
    }
    else if (per > 50 && per < 80)
    {
        printf("Grade D");
    }
    else
        printf("FAIL");
    return 0;
}
