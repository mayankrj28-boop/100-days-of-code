#include <stdio.h>
int main()
{
    float profit = 0, loss;
    printf("Enter price of article : ");
    float cp, sp;
    scanf("%f", &cp);

    printf("Enter selling price : ");
    scanf("%f", &sp);
    if ((profit = sp - cp) > 0)
    {
        profit = (profit / cp) * 100;
        printf("Profit of %.2f%%", profit);
    }

    else if ( (loss = sp - cp) < 0 )
    {
        loss = (cp - sp) / cp * 100;
        printf("Loss of %.2f %%", loss);
    }

    else 
    {
        printf("No profit or loss ");
    }
}
