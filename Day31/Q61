#include <stdio.h>
#include <stdio.h>
int l;
int input()
{
    printf("Enter length of Array. ");
    scanf("%d", &l);
}

int main()
{
    input();
    int ar[l];
    for (int i = 0; i < l; i++)
    {
        printf("Enter element for %d index :", i);
        scanf("%d", &ar[i]);
    }
    int s;
    printf("Enter number.");
    scanf("%d", &s);
    for (int i = 0; i < l; i++)
    {
        if(ar[i]==s)
        {
            printf("Searched number (%d) found at %d index", s, i);
            break;
        }
    }
}
