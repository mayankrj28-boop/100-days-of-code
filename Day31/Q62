#include <stdio.h>

int l;

int input()
{
    printf("Enter length of Array. ");
    scanf("%d", &l);
}

int main()
{
    input();
    int ar[l];

    for (int i = 0; i < l; i++)
    {
        printf("Enter element for %d index :", i);
        scanf("%d", &ar[i]);
    }

    for (int i = 0; i < l / 2; i++)
    {
        int temp = ar[i];
        ar[i] = ar[l - 1 - i];
        ar[l - 1 - i] = temp;
    }

    printf("Reversed array: ");
    for (int i = 0; i < l; i++)
    {
        printf("%d ", ar[i]);
    }

    return 0;
}
