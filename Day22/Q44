#include <stdio.h>
int main()
{
    double sum = 1;
    int term;
    printf("Enter terms : ");
    scanf("%d", &term);

    if (term < 1)
    {
        return 0;
    }

    for (int i = 2; i <= (term); i++)
    {
        sum= sum + ((2.0 *i)- 1) / (2.0 * i);

        // sum = sum + (((i * i) - 1) / (float) (i * i));
    }

    printf("Sum of series is %.1lf", sum);
}
